{
  "name": "art-randomizer", 
  "version": "1.0.0",
  "private": true,
  "description": "An art prompt and character randomizer", 
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.14",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.codedbycupidity.art-randomizer", 
    "productName": "Art Randomizer", 
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "out"
    },
    "mac": {
      "target": "dir",
      "icon": "assets/app-icons/my-icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/app-icons/my-icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/app-icons/my-icon.png"
    }
  }
}